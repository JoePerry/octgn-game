<?xml version="1.0" encoding="utf-8"?>
<game name="Epic Battles CCG" id="336cc7ef-c808-5f75-a22e-0171564da1e3" version="0.1.0.0" tags="SCORE 1v1 Epic Battles Beta" description="Epic Battles CCG OCTGN beta for playtesting." authors="Joe Perry" setsurl="https://github.com/JoePerry/octgn-game" gameurl="https://sites.google.com/site/epicbattlestcg/epic-battles" iconurl="https://raw.githubusercontent.com/JoePerry/octgn-game/main/sets/set1/images/example-card.jpg" octgnVersion="3.1.240.0" scriptVersion="3.1.0.2" markersize="25" usetwosidedtable="False">
  <scripts>
    <script src="Scripts/actions.py" />
  </scripts>
  <events />
  <sounds />
  <fonts />
  <symbols />
  <markers />
  <proxygen definitionsrc="Proxies/proxydef.xml" />
  <phases>
    <phase name="Draw" icon="Resources/placeholder.jpg" />
    <phase name="Set" icon="Resources/placeholder.jpg" />
    <phase name="Battle" icon="Resources/placeholder.jpg" />
    <phase name="Discard" icon="Resources/placeholder.jpg" />
    <phase name="End" icon="Resources/placeholder.jpg" />
  </phases>
  <documents />
  <gameModes />
  <globalvariables />
  <card back="Resources/placeholder.jpg" front="Resources/placeholder.jpg" width="63" height="88" cornerRadius="2">
    <property name="Number" type="String" textKind="Free" hidden="False" ignoreText="False" />
    <property name="Rarity" type="String" textKind="Free" hidden="False" ignoreText="False" />
    <property name="Card Type" type="String" textKind="Free" hidden="False" ignoreText="False" />
    <property name="Attack" type="String" textKind="Free" hidden="False" ignoreText="False" />
    <property name="Attack Type" type="String" textKind="Free" hidden="False" ignoreText="False" />
    <property name="Cost" type="String" textKind="Free" hidden="False" ignoreText="False" />
    <property name="Damage" type="String" textKind="Free" hidden="False" ignoreText="False" />
    <property name="Link" type="String" textKind="Free" hidden="False" ignoreText="False" />
    <property name="Text" type="RichText" textKind="Free" hidden="False" ignoreText="False" />
  </card>
  <table name="Table" visibility="undefined" ordered="False" width="800" height="650" background="Resources/placeholder.jpg" backgroundStyle="uniformToFill">
    <groupaction menu="Flip a Coin" shortcut="ctrl+shift+r" execute="flipCoin" />
    <groupaction menu="Roll a 6-sided Die" shortcut="ctrl+r" execute="rollDice" />
    <groupaction menu="Pass" shortcut="tab" execute="passTurn" />
    <cardaction menu="Rotate Card" default="True" batchExecute="rotate" />
    <cardaction menu="Flip Card Face Up/Down" shortcut="ctrl+f" batchExecute="flip" />
    <cardaction menu="Add/Remove Highlight" shortcut="ctrl+a" batchExecute="highlightCard" />
  </table>
  <player>
    <group name="Hand" visibility="me" ordered="False" icon="Resources/placeholder.jpg" viewState="expanded">
      <cardaction menu="Discard Card" shortcut="del" execute="discard" />
      <groupaction menu="Randomly Discard a Card" execute="randomDiscard" />
    </group>
    <group name="Deck" visibility="none" icon="Resources/placeholder.jpg">
      <groupaction menu="Draw" shortcut="ctrl+d" default="True" execute="draw" />
      <groupaction menu="Draw X Cards" shortcut="ctrl+shift+d" execute="drawMany" />
      <groupaction menu="Shuffle" shortcut="ctrl+s" execute="shuffle" />
    </group>
    <group name="Energy Pile" visibility="all" icon="Resources/placeholder.jpg" />
    <group name="Discard Pile" visibility="all" icon="Resources/placeholder.jpg" />
    <group name="Removed From Game" visibility="all" icon="Resources/placeholder.jpg" />
    <group name="Side Deck" visibility="me" icon="Resources/placeholder.jpg" />
    <group name="Character" visibility="all" icon="Resources/placeholder.jpg" />
  </player>
  <shared />
  <deck>
    <section name="Character" group="Character" />
    <section name="Side Deck" group="Side Deck" />
    <section name="Main Deck" group="Deck" />
  </deck>
